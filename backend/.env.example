# Copia este archivo como .env y ajusta los valores. El archivo .env NO se sube a GitHub.
# Con Docker Compose no hace falta: las variables se toman del .env de la raíz del proyecto.

PORT=3000
TZ=America/Santiago
# Orígenes que pueden llamar a la API desde el navegador (separados por coma)
CORS_ORIGIN=http://localhost:5173

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=reservaunab
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=reservaunab

# MongoDB
MONGO_URI=mongodb://localhost:27017/reservaunab

# Firma de los tokens de sesión: usa un texto largo y aleatorio (por ejemplo: openssl rand -hex 32)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h
