# Variables del frontend (Vite). Copia este archivo como .env si necesitas cambiarlas.
# Ninguna es secreta: todo lo que empieza con VITE_ queda dentro del JavaScript que descarga el navegador.

# Ruta base de la API. Con "/api" las peticiones pasan por el proxy de Vite (desarrollo) o de nginx (Docker).
VITE_API_URL=/api

# Solo desarrollo: a dónde redirige Vite las peticiones a /api
API_PROXY_TARGET=http://localhost:3000
