# Variables para docker compose. Copia este archivo como .env y cambia las claves:
#   cp .env.example .env
# El archivo .env no se sube a GitHub (está en .gitignore).

# PostgreSQL
POSTGRES_USER=reservaunab
POSTGRES_PASSWORD=cambia-esta-clave
POSTGRES_DB=reservaunab

# Firma de los tokens de sesión: un texto largo y aleatorio (por ejemplo, el resultado de: openssl rand -hex 32)
JWT_SECRET=cambia-este-secreto-por-uno-largo-y-aleatorio
JWT_EXPIRES_IN=8h

# Puertos en tu computador (cámbialos si ya están ocupados)
FRONTEND_PORT=8080
API_PORT=3000
POSTGRES_PORT_HOST=5432
MONGO_PORT_HOST=27017
